# Copy to .env, fill in, and chmod 600. Never commit .env — this repo is public.

# ── the vault ────────────────────────────────────────────────────────────────
# A clone of the content repository this service writes into. It only ever
# touches VAULT_SECTION, and always with an explicit pathspec.
#
# Clone it with --filter=blob:none: the history is worth having, the blobs of
# every file ever committed are not.
VAULT_DIR=/home/hermes/services/scholion-places/vault
VAULT_SECTION=content/places

# Who the commits are attributed to. Not a person: the audit log records which
# principal asked, and the commit records that it was this service that wrote.
GIT_AUTHOR_NAME=scholion-places
GIT_AUTHOR_EMAIL=scholion-places@localhost

# Pull and push in the background. Turn off in an environment with no remote.
AUTO_PUSH=true
PUSH_DELAY_MS=2000

# How often to pull the remote and re-read whatever changed. Somebody editing a
# place.json by hand and pushing is a supported way to work.
SYNC_INTERVAL_MS=300000

# ── where to listen ──────────────────────────────────────────────────────────
# Loopback only. Reaching this service goes through a reverse proxy that stamps
# the X-Api-Key, so no client ever holds a credential.
PORT=8009
HOST=127.0.0.1

# ── derived state ────────────────────────────────────────────────────────────
# The search index. Rebuilt from the records at boot, so deleting it costs
# nothing but the second it takes to read them again.
INDEX_PATH=./places.db

# Photos waiting to be attached to a visit. Outside the vault on purpose:
# rubbish in a git repository is forever.
STAGING_DIR=./staging
STAGING_TTL_HOURS=24

# ── access ───────────────────────────────────────────────────────────────────
# Principals and what each may do. See acl.example.json.
# Edits take effect without a restart: the file is re-read when its mtime moves.
ACL_PATH=./acl.json

LOG_DIR=./logs
LOG_RETENTION_DAYS=30

# A ceiling on writes per principal. Sized to stop a client in a retry loop, not
# a person: nobody records thirty flowers in a minute, and every write is a commit.
MAX_WRITES_PER_MIN=30
MAX_WRITES_PER_DAY=400

# ── published detail ─────────────────────────────────────────────────────────
# Decimal places kept in coordinates. Six is about ten centimetres; four is
# about eleven metres. The records are published, so this is a deliberate choice
# rather than whatever the phone reported.
COORD_PRECISION=6

# How close a new place may be to an existing one before the service assumes it
# is the same field seen again, and refuses. Pass force: true to override.
NEIGHBOUR_RADIUS_M=80

# ── photos ───────────────────────────────────────────────────────────────────
# The only lever on repository size: git never forgets a blob. At 300 KB a photo,
# three thousand photos add nearly a gigabyte that no later decision takes back.
PHOTO_MAX_PX=1600
PHOTO_QUALITY=3
PHOTO_MAX_BYTES=12582912
FFMPEG_PATH=ffmpeg
